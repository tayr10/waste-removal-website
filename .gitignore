# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/settings.json
.vscode/launch.json

# Node (if npm tools ever get used)
node_modules/
npm-debug.log*

# Environment / secrets — never commit these
.env
*.env
secrets.txt
passwords.txt

# Raw camera originals — huge, and git keeps them forever.
# Compressed versions live in assets/optimized/ and site/images/ and ARE committed.
assets/photos/*
!assets/photos/.gitkeep
